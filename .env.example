# Server Configuration
NODE_ENV=production
PORT=10000

# Client Origin (set to your deployment frontend URL)
# Example: https://intervalai-client.onrender.com
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Connection
# Development (via SSH tunnel): mongodb://root:PASSWORD@localhost:27017/intervalai?authSource=admin
# Production (K8s): mongodb://root:PASSWORD@mongodb-intervalai.default.svc.cluster.local:27017/intervalai?authSource=admin
# To connect locally, first establish SSH tunnel: ssh -L 27017:MONGODB_SERVICE_IP:27017 user@vps-ip
MONGODB_URI=mongodb://root:PASSWORD@localhost:27017/intervalai?authSource=admin


# JWT Configuration
# Use a long random string for production (deployment platform can auto-generate this)
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRY=7d

# Test Database (only for development)
TEST_DATABASE_URL=mongodb://localhost/thinkful-backend-test

# TensorFlow.js Backend Configuration
# Options:
#   - auto: Try GPU → Native CPU → Pure JS (recommended for development)
#   - gpu: Force GPU backend (requires NVIDIA GPU + CUDA)
#   - node: Force native CPU backend (requires AVX instructions)
#   - cpu: Force pure JavaScript backend (works on any CPU, even without AVX)
# Production note: Set to 'cpu' for CPUs without AVX support (Celeron, Atom, etc.)
TFJS_BACKEND=auto
